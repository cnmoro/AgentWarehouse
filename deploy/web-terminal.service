# User service. Install with:
#   mkdir -p ~/.config/systemd/user
#   cp deploy/web-terminal.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now web-terminal
#   loginctl enable-linger $USER   # keep it running after you log out
[Unit]
Description=Web Terminal
# The user manager can't see tailscaled.service; wait for its network device instead.
Wants=sys-subsystem-net-devices-tailscale0.device
After=sys-subsystem-net-devices-tailscale0.device

[Service]
WorkingDirectory=/mnt/dados1/claude-manager
ExecStart=/usr/bin/node --env-file-if-exists=.env server.js
Restart=on-failure
RestartSec=5
# 78 = configuration error (e.g. no users yet); restarting would just loop.
RestartPreventExitStatus=78
KillMode=control-group

[Install]
WantedBy=default.target
