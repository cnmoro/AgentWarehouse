# Copy to .env and adjust. All values are optional.

# Port to listen on.
PORT=7681

# Address to bind. Leave unset to bind only to this machine's Tailscale IPv4
# address. If Tailscale is not up, the server exits and systemd retries.
# HOST=100.x.y.z

# More addresses to listen on, besides HOST (comma-separated). Use this to open the page from other devices on the home
# network too, with this machine's address there, e.g. its LAN address. It is plain HTTP on that network, so use it only on
# a network you trust; Tailscale (or `tailscale serve`) is the encrypted way. Give the machine a fixed address (a DHCP
# reservation), because the address is written here. Never use 0.0.0.0.
# LISTEN_ALSO=192.168.1.20

# Set to 1 to serve HTTPS with a self-signed certificate that the server makes itself (in DATA_DIR/tls/, naming every
# address it accepts). The browser warns once per device and address until you accept it; after that the page is a
# secure context: the microphone (dictation), the Desktop's WebCodecs and the async clipboard work. Needs `openssl`.
# HTTPS_CERT / HTTPS_KEY (both) use your own certificate files instead.
# HTTPS=1
# Extra host names the browser may use, comma-separated. This machine's
# Tailscale IPs, MagicDNS name, hostname and localhost are always accepted.
# ALLOWED_HOSTS=terminal.example.ts.net

# Set to 1 when running behind `tailscale serve` (HTTPS). The server then binds
# to 127.0.0.1 and trusts X-Forwarded-* headers from the proxy.
# TRUST_PROXY=1

# Session lifetime: absolute maximum and maximum idle time, in hours.
SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=24

# Lines of scrollback kept in memory per terminal (in the server and in each
# browser, and replayed on reconnect). Keep this moderate; use HISTORY_LINES
# for long history.
SCROLLBACK=10000
# Most terminals open at once (a guard against a runaway script). Each costs a shell plus a few MB in the server.
MAX_TERMINALS=200

# Older lines kept on disk per terminal, shown on demand in the history view
# (Ctrl+Shift+H). 0 turns it off.
HISTORY_LINES=200000
# ...and at most this many megabytes of it per terminal.
HISTORY_MB=64
